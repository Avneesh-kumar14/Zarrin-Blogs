# ================================================
# ZARRIN BLOGS - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ================================================

# SERVER CONFIGURATION
PORT=8200
NODE_ENV=development

# DATABASE
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/zarrin_blogs?retryWrites=true&w=majority

# JWT AUTHENTICATION
JWT_SECRET=your_secret_key_here_use_strong_random_string_min_32_chars

# CLOUDINARY (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ✅ EMAIL OTP CONFIGURATION - RESEND
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@yourdomain.com

# FRONTEND URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://zarrin-blogs-frontend.vercel.app

# ================================================
# IMPORTANT SETUP INSTRUCTIONS:
# ================================================
# 
# 1. JWT_SECRET: Generate a strong random string using:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. CLOUDINARY: Get credentials from https://cloudinary.com
#    - Sign up for free account
#    - Get Cloud Name, API Key, API Secret from dashboard
#
# 3. RESEND EMAIL SERVICE (Recommended):
#    - Sign up at https://resend.com (free 100/day)
#    - Get API Key from dashboard (Settings → API Keys)
#    - Verify your domain or use onboarding@resend.dev for testing
#    - RESEND_API_KEY: Your API key (starts with re_)
#    - RESEND_FROM_EMAIL: Your sender email (noreply@yourdomain.com or onboarding@resend.dev)
#
# 4. MONGO_URL: Use MongoDB Atlas free tier
#    - Create account at https://www.mongodb.com/cloud/atlas
#    - Create a cluster
#    - Get connection string and update with your credentials
#
# ================================================